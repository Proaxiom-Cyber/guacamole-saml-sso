# Non-secret configuration only. Copy to .env and fill it in.
# Passwords and tokens do not belong here. setup.sh asks for the database
# password and gets the tunnel token from Cloudflare without displaying it.

# Optional command that retrieves the database password from your secret store.
# Use a command and arguments, or the path to a helper script. No secret values.
# Empty means setup.sh asks for the password. Reuse the same password on each run.
POSTGRES_PASSWORD_CMD=

# Version of the Guacamole images. The database schema is generated from this
# same version by setup.sh, so the two can never drift apart.
GUAC_VERSION=1.6.0

# Public hostname of the service. It must match the certificate in nginx/certs
# and the SAML entity ID registered with the identity provider.
GUAC_HOSTNAME=guacamole.example.com

# Host port for HTTPS. Change it if something else on the host uses 443.
HTTPS_PORT=443

# SAML metadata URL of the identity provider.
#   Entra ID: leave it empty. setup.sh registers the application and fills it in.
#   Okta:     https://<org>.okta.com/app/<app-id>/sso/saml/metadata
#   Keycloak: https://<host>/realms/<realm>/protocol/saml/descriptor
SAML_IDP_METADATA_URL=

# Entra ID only. The user attribute that becomes the SAML NameID, so it must
# hold the account name on the target hosts. "mailnickname" works for every
# account; "onpremisessamaccountname" is only set on AD-synced accounts.
ENTRA_NAMEID_ATTRIBUTE=mailnickname

# Name of the SAML attribute that carries group membership. Entra ID sends
# "http://schemas.microsoft.com/ws/2008/06/identity/claims/groups" unless the
# group claim is renamed to "groups" in the enterprise application.
SAML_GROUP_ATTRIBUTE=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups

# The two authorisation groups. Each name must match what the identity provider
# sends in the group claim, exactly. Members of the operator group create and
# manage connections. Members of the administrator group only use them.
GUAC_ADMIN_GROUP=Guacamole Administrators
GUAC_OPERATOR_GROUP=Guacamole Operators

# Cloudflare publishing: a tunnel, a proxied DNS record, and Cloudflare Access
# with Entra ID sign-in in front. setup.sh sets it up and asks for a Cloudflare
# API token (or reads CLOUDFLARE_API_TOKEN / CLOUDFLARE_TOKEN_CMD). Leave the
# profile empty to skip Cloudflare and expose HTTPS_PORT yourself.
COMPOSE_PROFILES=cloudflare

# Cloudflare account ID: dashboard > the account > Overview, right-hand column.
# Used to link you straight to the token page. setup.sh asks if it is empty.
CLOUDFLARE_ACCOUNT_ID=

# Domain selected during setup. Leave empty to select a domain on the first run.
CLOUDFLARE_ZONE_ID=

# Zero Trust team name. Used only if the Cloudflare account has no team yet;
# it becomes <team>.cloudflareaccess.com.
CLOUDFLARE_TEAM=
